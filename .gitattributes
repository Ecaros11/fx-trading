# 统一换行符为 LF —— 避免 Windows/Linux 之间来回改动整个文件
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.npy  binary
*.npz  binary
*.pkl  binary
*.zip  binary

# 大体积数据文件——在 GitHub 上折叠显示、不计入语言统计
data/crypto/*.json   linguist-generated=true -diff
data/funding/*.json  linguist-generated=true -diff
*.csv                linguist-generated=true
